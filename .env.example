# 241 Runners Awareness — environment template (copy to .env, never commit secrets)
# Production Azure credentials remain in Azure until explicit cutover.

# --- Database provider ---
# SqlServer (default, production) | Postgres (Supabase staging/cutover)
DATABASE_PROVIDER=SqlServer

# Azure SQL (source / production rollback)
AZURE_SQL_CONNECTION_STRING=Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;

# Supabase PostgreSQL (target staging)
# From Supabase Dashboard → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project (for CLI / storage)
SUPABASE_PROJECT_REF=hylwpwauxlnrqvbkmcln
SUPABASE_URL=https://hylwpwauxlnrqvbkmcln.supabase.co
SUPABASE_ANON_KEY=
# Service role: server-side only (API, migration tooling) — NEVER expose to clients
SUPABASE_SERVICE_ROLE_KEY=

# API auth (unchanged during Phase A migration)
JWT_KEY=your-super-secret-key-at-least-32-characters-long
JWT_ISSUER=241RunnersAwareness
JWT_AUDIENCE=241RunnersAwareness

# Azure Blob (source images)
AZURE_STORAGE_CONNECTION_STRING=

# Supabase Storage (target images bucket)
SUPABASE_STORAGE_BUCKET=images

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=

# Migration tooling
MIGRATION_MANIFEST_PATH=config/migration-manifest.json
MIGRATION_DRY_RUN=true
