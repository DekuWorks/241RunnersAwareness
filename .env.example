# 241 Runners Awareness — environment template (copy to .env, never commit secrets)
# Supabase-first: Postgres + Storage. Azure vars kept only for legacy rollback tooling.

# --- Database (Supabase PostgreSQL) ---
DATABASE_PROVIDER=Postgres
STORAGE_PROVIDER=Supabase

# Supabase pooler connection (Dashboard → Database → Connection string → URI, use pooler host)
ConnectionStrings__DefaultConnection=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase project
SUPABASE_PROJECT_REF=hylwpwauxlnrqvbkmcln
SUPABASE_URL=https://hylwpwauxlnrqvbkmcln.supabase.co
SUPABASE_ANON_KEY=
# Service role: server-side only (API, migration tooling) — NEVER expose to clients
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images

# API auth
JWT_KEY=your-super-secret-key-at-least-32-characters-long
JWT_ISSUER=241RunnersAwareness
JWT_AUDIENCE=241RunnersAwareness
PUBLIC_API_BASE_URL=http://localhost:5051

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# --- Legacy Azure (rollback only — not used in Supabase-first mode) ---
# AZURE_SQL_CONNECTION_STRING=
# AZURE_STORAGE_CONNECTION_STRING=

# Migration tooling
MIGRATION_MANIFEST_PATH=config/migration-manifest.json
MIGRATION_DRY_RUN=true
